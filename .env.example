# Copy this file to .env for local dev, or set these as Environment Variables in Render.

# Required for the AI Trip Planner / Ask The Place / Translator features
GROQ_API_KEY=

# Optional fallback AI provider (used if Groq fails/is unset)
GEMINI_API_KEY=

# JWT signing secret for auth (set to a long random string)
JWT_SECRET=

# Database connection (see server/db.ts for the expected format)
DATABASE_URL=

# Port Render will set this automatically — only needed for local dev
PORT=3001
